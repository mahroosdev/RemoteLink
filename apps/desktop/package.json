{
  "name": "remotelink-desktop",
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc && vite build",
    "electron": "npm run electron:dev",
    "package": "npm run build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "npm run dev"
  },
  "build": {
    "appId": "com.nexadigital.remotelink",
    "productName": "RemoteLink",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "public/remotelink-app.ico"
    }
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^1.24.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.0.2",
    "vite": "^8.1.4",
    "vite-plugin-electron": "^1.1.0"
  }
}
